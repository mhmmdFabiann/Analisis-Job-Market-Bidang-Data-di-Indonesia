markdown/

# 4. Python Environment & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# 5. Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# 6. IDEs & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 7. Operating System Files
.DS_Store
Thumbs.db
desktop.ini
